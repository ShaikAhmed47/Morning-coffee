@model IEnumerable<MorningCoffee.Models.Category>
@{ViewBag.Title="Categories";}<div class="d-flex justify-content-between"><h1>Categories</h1><a class="btn btn-primary" href="@Url.Action("CategoryForm")">+ Add Category</a></div>
<table class="table mt-3"><tr><th>Name</th><th>Description</th><th>Active</th><th></th></tr>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Description</td><td>@c.IsActive</td><td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("CategoryForm",new{id=c.CategoryId})">Edit</a></td></tr>}</table>
