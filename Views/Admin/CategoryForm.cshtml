@model MorningCoffee.Models.Category
@{ViewBag.Title="Category";}<h1>@(Model.CategoryId==0?"Add Category":"Edit Category")</h1>
@using(Html.BeginForm()){ @Html.AntiForgeryToken(); @Html.HiddenFor(x=>x.CategoryId)
<div class="mb-3">@Html.LabelFor(x=>x.Name) @Html.TextBoxFor(x=>x.Name,new{@class="form-control"})</div>
<div class="mb-3">@Html.LabelFor(x=>x.Description) @Html.TextAreaFor(x=>x.Description,new{@class="form-control"})</div>
<div class="form-check mb-3">@Html.CheckBoxFor(x=>x.IsActive,new{@class="form-check-input"}) @Html.LabelFor(x=>x.IsActive)</div>
<button class="btn btn-primary">Save</button>}
