@model IEnumerable<MorningCoffee.Models.Order>
@{ViewBag.Title="Orders";}<h1>Orders</h1><table class="table"><tr><th>#</th><th>Customer</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr>@foreach(var o in Model){<tr><td>@o.OrderId</td><td>@o.Customer.FullName</td><td>@o.OrderDate.ToString("dd MMM yyyy HH:mm")</td><td>@o.Status</td><td>₹@o.Total.ToString("0.00")</td><td><a class="btn btn-sm btn-primary" href="@Url.Action("OrderDetails",new{id=o.OrderId})">View</a></td></tr>}</table>
