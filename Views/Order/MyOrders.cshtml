@model IEnumerable<MorningCoffee.Models.Order>
@{ViewBag.Title="My Orders";}<h1>My Orders</h1>
<table class="table"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderId</td><td>@o.OrderDate.ToString("dd MMM yyyy HH:mm")</td><td><span class="badge bg-secondary">@o.Status</span></td><td>₹@o.Total.ToString("0.00")</td></tr>}</tbody></table>
