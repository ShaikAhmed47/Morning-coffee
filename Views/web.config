<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, System.Web.WebPages.Razor">
      <section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, System.Web.WebPages.Razor" requirePermission="false"/>
      <section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, System.Web.WebPages.Razor" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <system.web.webPages.razor>
    <host factoryType="System.Web.Mvc.MvcWebRazorHostFactory, System.Web.Mvc, Version=5.2.9.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
    <pages pageBaseType="System.Web.Mvc.WebViewPage">
      <namespaces>
        <add namespace="System.Web.Mvc"/><add namespace="System.Web.Mvc.Ajax"/><add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/><add namespace="MorningCoffee"/><add namespace="MorningCoffee.Models"/>
        <add namespace="MorningCoffee.ViewModels"/>
      </namespaces>
    </pages>
  </system.web.webPages.razor>
  <appSettings><add key="webpages:Enabled" value="false"/></appSettings>
  <system.web><httpHandlers><add path="*" verb="*" type="System.Web.HttpNotFoundHandler"/></httpHandlers><pages validateRequest="false" pageParserFilterType="System.Web.Mvc.ViewTypeParserFilter, System.Web.Mvc, Version=5.2.9.0"/><httpRuntime requestValidationMode="2.0"/></system.web>
</configuration>
